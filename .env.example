# Root .env -- read automatically by `docker compose` (copy to `.env`).
# These are DEV placeholders so `docker compose up --build` works out of the
# box; replace every secret before exposing the stack anywhere real.

# Host port for Postgres (change if 5432 is already taken on your machine).
DB_PORT=5432

# Browser-facing backend URL baked into the frontend bundle at build time.
# Rebuild the frontend after changing it: `docker compose up --build`.
VITE_BACKEND_URL=http://localhost:5000

# NFR-SEC-04/06: required, the backend refuses to start without it.
USER_ID_PEPPER=dev-only-pepper-change-me-0123456789abcdef0123456789abcdef

# NFR-SEC-01: operator login + JWT signing key.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=change_me
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef0123456789abcdef

# NFR-SEC-02: shared secret the Game Client trades for a /game JWT.
GAME_CLIENT_SECRET=dev-only-game-secret-change-me-0123456789abcdef

# Optional: Euler Stream API key (higher TikTok WebSocket-signing rate limit).
EULER_API_KEY=

# NFR-SEC-04: days of per-viewer data kept before the daily retention job
# deletes/scrubs it (0 = disabled).
RETENTION_DAYS=30
