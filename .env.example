# .env (thư mục gốc) -- CHỈ dùng khi chạy bằng `docker compose up`.
# Khác với backend/.env.example (dùng khi chạy backend trực tiếp bằng `node`/
# `npm run dev`, không qua Docker) -- 2 file không tự đồng bộ, sửa 1 bên
# không ảnh hưởng bên kia. Nếu bạn chạy cả 2 cách, cần tạo cả 2 file.
#
# Copy file này thành `.env` (cùng thư mục gốc, cạnh docker-compose.yml),
# điền giá trị thật, rồi `docker compose up -d`. KHÔNG commit file `.env`
# thật (đã có trong .gitignore) -- chỉ file .env.example này được commit.

# NFR-SEC-01: tài khoản Operator duy nhất để đăng nhập (POST /api/login).
# Thiếu 2 biến này, LoginPage sẽ luôn báo "server chưa cấu hình xác thực".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi_mat_khau_nay

# Bắt buộc, dùng để ký JWT -- để trống sẽ làm login lỗi. Sinh 1 chuỗi ngẫu
# nhiên bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Euler Stream API key (tạo tại https://www.eulerstream.com) -- nâng giới
# hạn rate-limit ký WebSocket cho tiktok-live-connector. Để trống vẫn chạy
# được, nhưng dùng chung pool ẩn danh bị giới hạn nặng (xem RSK-01).
EULER_API_KEY=
