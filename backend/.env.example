PORT=5000
NODE_ENV=development
# Matches docker-compose.yml's `db` service. When running the backend
# outside Docker against that same container, swap host `db` for `localhost`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tiktok_live_monitor
# Euler Stream API key (create one at https://www.eulerstream.com) -- raises
# the WebSocket-signing rate limit above the shared free community pool.
# Leave blank to fall back to the (heavily rate-limited) anonymous pool.
EULER_API_KEY=
# RSK-01: sustained anonymous connections from a single outbound IP risk
# TikTok/Euler Stream rate-limiting or blocking it. Prep for a rotating proxy
# pool -- comma-separated proxy URLs, e.g.
# http://user:pass@host1:port,http://user:pass@host2:port
# Not wired into TikTokLiveConnection yet: doing so needs a proxy-agent
# dependency (e.g. https-proxy-agent) passed via its webClientOptions/
# wsClientOptions once a provider is chosen. Leave blank until then.
TIKTOK_PROXY_LIST=
# How connectToLiveStream() should pick from TIKTOK_PROXY_LIST once wired up.
# "round-robin" | "random"
TIKTOK_PROXY_ROTATION=round-robin
# NFR-SEC-01: single shared operator login for POST /api/login. Pick a real
# password here -- do not commit real credentials, this file only ships
# placeholders.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=change_me
# Any long random string; e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h
